local function FallbackIcon(name, s, color)
    local c = New("Frame", { Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1 })
    local mid = UDim2.fromScale(0.5, 0.5)
    if name == "x" or name == "trash-2" then
        Bar(c, s * 0.85, 2, mid, 45, color)
        Bar(c, s * 0.85, 2, mid, -45, color)
    elseif name == "minus" then
        Bar(c, s * 0.8, 2, mid, 0, color)
    elseif name == "chevron-up" or name == "chevron-right" then
        Bar(c, s * 0.6, 2, UDim2.fromScale(0.3, 0.6), -45, color)
        Bar(c, s * 0.6, 2, UDim2.fromScale(0.7, 0.6), 45, color)
        if name == "chevron-right" then c.Rotation = 90 end
    elseif name == "star" or name == "sparkles" then
        for _, rot in ipairs({ 0, 45 }) do
            New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = mid,
                Size = UDim2.fromOffset(s * 0.62, s * 0.62),
                Rotation = rot,
                BackgroundColor3 = color,
                BorderSizePixel = 0,
                Parent = c,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 2) }) })
        end
    elseif name == "move" then
        Bar(c, s * 0.9, 2, mid, 0, color)
        Bar(c, 2, s * 0.9, mid, 0, color)
    else
        New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = mid,
            Size = UDim2.fromOffset(s * 0.45, s * 0.45),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Parent = c,
        }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    end
    return c
end

local function IsAssetIcon(name)
    if typeof(name) == "number" then return true end
    if type(name) ~= "string" then return false end
    return name:match("^%d+$") ~= nil
        or name:match("^rbxassetid://%d+$") ~= nil
        or name:match("^rbxthumb://") ~= nil
end

local function ToAssetId(name)
    if typeof(name) == "number" then return "rbxassetid://" .. tostring(name) end
    if name:match("^%d+$") then return "rbxassetid://" .. name end
    return name
end

local function Icon(name, size, color)
    if IsAssetIcon(name) then
        local img = New("ImageLabel", {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
            Image = ToAssetId(name),
            ImageColor3 = Color3.new(1, 1, 1),
            ScaleType = Enum.ScaleType.Fit,
        })
        img:SetAttribute("RawAsset", true)
        return img
    end

    local data
    if Lucide then
        local ok, res = pcall(function() return Lucide.Icon2(name) end)
        if ok then data = res end
    end
    if type(data) == "table" and data[1] and data[2] then
        return New("ImageLabel", {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
            Image = data[1],
            ImageRectSize = data[2].ImageRectSize,
            ImageRectOffset = data[2].ImageRectPosition,
            ImageColor3 = color,
        })
    end
    return FallbackIcon(name, size, color)
end

local function IconColor(icon, color, time)
    if icon:IsA("ImageLabel") then
        if icon:GetAttribute("RawAsset") then return end
        Tween(icon, time or 0.2, { ImageColor3 = color })
    else
        for _, d in ipairs(icon:GetChildren()) do
            if d:IsA("Frame") then Tween(d, time or 0.2, { BackgroundColor3 = color }) end
        end
    end
end

local function StarField(parent, count, isActive)
    local holder = New("Frame", {
        Name = "StarField",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 1,
        Parent = parent,
    })

    local stars = {}
    local function Reset(st, initial)
        st.x = math.random()
        st.y = initial and math.random() or (-0.05 - math.random() * 0.5)
        st.speed = 0.15 + math.random() * 0.6
    end

    for i = 1, count or 40 do
        local w = (math.random() < 0.2) and 2 or 1
        local h = math.random(6, 18)
        local f = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0),
            Size = UDim2.fromOffset(w, h),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1 - STAR_BRIGHTNESS * (1 - (0.1 + math.random() * 0.5)),
            BorderSizePixel = 0,
            ZIndex = 1,
            Parent = holder,
        }, {
            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
            New("UIGradient", {
                Rotation = 90,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(1, 0),
                }),
            }),
        })
        local st = { f = f }
        Reset(st, true)
        stars[i] = st
    end

    local conn = RunService.RenderStepped:Connect(function(dt)
        if isActive and not isActive() then return end
        for _, st in ipairs(stars) do
            st.y += st.speed * dt
            if st.y > 1.05 then Reset(st, false) end
            st.f.Position = UDim2.new(st.x, 0, st.y, 0)
        end
    end)
    local dots = {}
    for i = 1, 18 do
        dots[i] = {
            f = New("Frame", {
                Size = UDim2.fromOffset(2, 2),
                Position = UDim2.fromScale(math.random(), math.random()),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 1,
                Parent = holder,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) }),
            p = math.random() * 6.28,
            s = 0.8 + math.random() * 1.6,
        }
    end
    local clock = 0
    local conn2 = RunService.RenderStepped:Connect(function(dt)
        if isActive and not isActive() then return end
        clock += dt
        for _, d in ipairs(dots) do
            d.f.BackgroundTransparency = 1 - STAR_BRIGHTNESS * (1 - (0.6 + 0.38 * math.sin(clock * d.s + d.p)))
        end
    end)
    holder.Destroying:Connect(function() conn:Disconnect() conn2:Disconnect() end)
    return holder
end

