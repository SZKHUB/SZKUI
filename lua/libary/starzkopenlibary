    GetParent(Gui)

    local Frame = New("Frame", {
        Name = "StarButton",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = o.Position or UDim2.new(0.5, 0, 0, 40),
        Size = UDim2.new(0, o.Width or 0, 0, height),
