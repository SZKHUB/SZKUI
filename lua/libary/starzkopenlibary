    self.Scale = Scale
    Tween(Scale, 0.4, { Scale = self.TargetScale }, Enum.EasingStyle.Quint)

    local Stroke = New("UIStroke", {
        Thickness = 2,
        Color = Color3.new(1, 1, 1),
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = Frame,
    })
