function FloatingButton:Hide()
    self._tok += 1
    local tok = self._tok
    Tween(self.Scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    task.delay(0.22, function()
        if self._tok == tok and self.Frame.Parent then self.Frame.Visible = false end
    end)
end

function FloatingButton:Show()
    self._tok += 1
    self.Frame.Visible = true
    Tween(self.Scale, 0.35, { Scale = self.TargetScale }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
end

function FloatingButton:SetTitle(t) if self.Label then self.Label.Text = tostring(t) end end
function FloatingButton:SetPosition(p) self.Frame.Position = p end
function FloatingButton:SetOnClick(fn) self.OnClick = fn end
function FloatingButton:Destroy()
    self._tok += 1
    if self._conn then self._conn:Disconnect() end
    Tween(self.Scale, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    task.delay(0.35, function() self.Gui:Destroy() end)
end

