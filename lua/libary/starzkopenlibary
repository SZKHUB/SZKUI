    end
    if not gui.Parent then
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function BorderGlow(parent)
    local glow = New("UIStroke", {
        Thickness = 3,
        Color = Color3.new(1, 1, 1),
        Transparency = GLOW_T,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
    local glowGrad = New("UIGradient", { Color = BWGradient, Parent = glow })

    local line = New("UIStroke", {
        Thickness = 1.5,
        Color = Color3.new(1, 1, 1),
        Transparency = 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
    local lineGrad = New("UIGradient", { Color = BWGradient, Parent = line })

    local obj = {}

    function obj.Step(dt)
        local r = (lineGrad.Rotation + dt * 90) % 360
        lineGrad.Rotation = r
        glowGrad.Rotation = r
    end

    function obj.Fade(time, visible)
        local lt = visible and 0 or 1
        local gt = visible and GLOW_T or 1
        if time <= 0 then
            line.Transparency = lt
            glow.Transparency = gt
        else
            Tween(line, time, { Transparency = lt })
            Tween(glow, time, { Transparency = gt })
        end
    end

    function obj.Pulse()
        Tween(glow, 0.2, { Transparency = 0.55 })
        task.delay(0.3, function()
            if glow.Parent then Tween(glow, 0.6, { Transparency = GLOW_T }) end
        end)
    end

    return obj
end

