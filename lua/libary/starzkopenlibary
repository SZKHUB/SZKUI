    local conn = RunService.RenderStepped:Connect(function(dt)
        if Frame.Visible then Gradient.Rotation = (Gradient.Rotation + dt * 90) % 360 end
    end)

    self.Gui, self.Frame, self.Label, self.Button = Gui, Frame, Label, Button
    self.OnClick = o.OnClick
    self._conn = conn
    return self
