        Tween(Button, 0.15, { BackgroundTransparency = 0.88 })
        Tween(mainIcon, 0.4, { Rotation = 72 })
    end)
    Button.MouseLeave:Connect(function()
        Tween(Button, 0.15, { BackgroundTransparency = 1 })
        Tween(mainIcon, 0.4, { Rotation = 0 })
    end)
