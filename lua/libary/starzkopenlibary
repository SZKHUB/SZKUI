function STARZK:SetVisible(v)
    local Main = self.Main
    if not Main or not Main.Parent then return end
    v = v == true
    if v == self.Open then return end
    self.Open = v
    self._token += 1
    local token = self._token

    local Canvas, scale, border = self.Canvas, self._scale, self._border
    local base = self.BaseScale

    if v then
        if self.Button then self.Button:Hide() end
        if self.OnOpen then pcall(self.OnOpen) end
        local home = self._home

        task.delay(0.1, function()
            if self._token ~= token then return end
            Main.Position = home + UDim2.fromOffset(0, 12)
            scale.Scale = base * 0.95
            Canvas.GroupTransparency = 1
            border.Fade(0, false)
            Main.Visible = true

            Tween(Main, 0.35, { Position = home }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(scale, 0.35, { Scale = base }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(Canvas, 0.25, { GroupTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            border.Fade(0.3, true)
        end)
    else
        local home = Main.Position
        self._home = home

        Tween(Main, 0.25, { Position = home + UDim2.fromOffset(0, 10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(scale, 0.25, { Scale = base * 0.96 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(Canvas, 0.2, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        border.Fade(0.2, false)

        task.delay(0.2, function()
            if self._token == token then
                if self.Button then self.Button:Show() end
                if self.OnClose then pcall(self.OnClose) end
            end
        end)
        task.delay(0.28, function()
            if self._token == token and Main.Parent then
                Main.Visible = false
                Main.Position = home
                scale.Scale = base
            end
        end)
    end
end

function STARZK:Toggle() self:SetVisible(not self.Open) end

function STARZK:Notify(message)
    local t = self._toast
    if not t or not t.Frame.Parent then return end
    t.Token += 1
    local token = t.Token
    t.Label.Text = tostring(message)
    t.Frame.Visible = true
    Tween(t.Frame, 0.2, { BackgroundTransparency = 0.05 })
    Tween(t.Stroke, 0.2, { Transparency = 0.3 })
    Tween(t.Label, 0.2, { TextTransparency = 0 })
    task.delay(2.4, function()
        if t.Token ~= token or not t.Frame.Parent then return end
        Tween(t.Frame, 0.3, { BackgroundTransparency = 1 })
        Tween(t.Stroke, 0.3, { Transparency = 1 })
        Tween(t.Label, 0.3, { TextTransparency = 1 })
        task.delay(0.32, function()
            if t.Token == token and t.Frame.Parent then t.Frame.Visible = false end
        end)
    end)
end

function STARZK:SetUsername(name)
    local lp = Players.LocalPlayer
    local custom = name and name ~= ""
    if self.FooterName then self.FooterName.Text = custom and name or lp.DisplayName end
    if self.FooterUser then self.FooterUser.Text = "@" .. (custom and name or lp.Name) end
end

function STARZK:SetMinimized(m)
    self.Minimized = m
    local Main = self.Main
    if m then
        Tween(Main, 0.4, { Size = UDim2.fromOffset(FULL_W, TOP_H) }, Enum.EasingStyle.Quint)
        Tween(self._minIcon, 0.4, { Rotation = 180 })
        task.delay(0.2, function()
            if self.Minimized then
                self.Sidebar.Visible = false
                self.Pages.Visible = false
            end
        end)
    else
        self.Sidebar.Visible = true
        self.Pages.Visible = true
        Tween(Main, 0.4, { Size = UDim2.fromOffset(FULL_W, FULL_H) }, Enum.EasingStyle.Quint)
        Tween(self._minIcon, 0.4, { Rotation = 0 })
    end
end

function STARZK:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    self.OnClose = nil
    if self.Open then self:SetVisible(false) end
    if self.OnDestroy then pcall(self.OnDestroy) end
    if self.Button then self.Button:Destroy() end
    task.delay(0.7, function()
        if self._conn then self._conn:Disconnect() end
        self.Gui:Destroy()
    end)
end

