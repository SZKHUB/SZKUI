            Parent = row,
        })
        Hover(row, hit)
        local obj = {}
        function obj:Set(v, silent)
            state = v == true
            Tween(PillGlow, 0.2, { Transparency = state and 0.72 or 1 })
            Tween(Pill, 0.2, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
            Tween(Knob, 0.2, {
                BackgroundColor3 = state and Theme.Bg or Color3.fromRGB(190, 190, 198),
                Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
            })
            if callback and not silent then task.spawn(pcall, callback, state) end
        end
        function obj:Get() return state end
        hit.MouseButton1Click:Connect(function() obj:Set(not state) end)
        return obj
    end

    function tab:AddSlider(text, min, max, default, callback)
        local value = math.clamp(default or min, min, max)
        local row = Row(SLIDER_H)
        local lbl = RowLabel(row, text, 0.7)
        lbl.Size = UDim2.new(0.7, -12, 0, 24)
        lbl.Position = UDim2.new(0, 12, 0, 2)
        local val = New("TextLabel", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -12, 0, 2),
            Size = UDim2.fromOffset(60, 24),
            BackgroundTransparency = 1,
            Text = tostring(value),
            FontFace = Fnt(Enum.FontWeight.Bold),
            TextSize = TXT,
            TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 6,
            Parent = row,
        })
        local Bar = New("Frame", {
            Position = UDim2.new(0, 12, 0, 32),
            Size = UDim2.new(1, -24, 0, 6),
            BackgroundColor3 = Theme.Off,
            ZIndex = 6,
            Parent = row,
        }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
        local Fill = New("Frame", {
            Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = Theme.Accent,
            ZIndex = 7,
            Parent = Bar,
        }, {
            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
            New("UIGradient", {
                Color = ColorSequence.new(Theme.Mid, Theme.Accent),
            }),
        })
        local SKnob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 8,
            Parent = Fill,
        }, {
            New("UICorner", { CornerRadius = UDim.new(1, 0) }),
            New("UIStroke", { Color = Theme.Bg, Thickness = 2 }),
        })

        local sliding, slideInput = false, nil
        local function Update(x)
            local rel = math.clamp((x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * rel + 0.5)
            val.Text = tostring(value)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            if callback then task.spawn(pcall, callback, value) end
        end
        row.InputBegan:Connect(function(input)
            if sliding then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                sliding, slideInput = true, input
                Tween(SKnob, 0.15, { Size = UDim2.fromOffset(19, 19) }, Enum.EasingStyle.Back)
                Update(input.Position.X)
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End and slideInput == input then
                        sliding, slideInput = false, nil
                        Tween(SKnob, 0.15, { Size = UDim2.fromOffset(14, 14) })
                    end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not sliding or not slideInput then return end
            local mine = (input == slideInput)
                or (slideInput.UserInputType == Enum.UserInputType.MouseButton1
                    and input.UserInputType == Enum.UserInputType.MouseMovement)
            if mine then Update(input.Position.X) end
        end)
    end

    local function BoxStyle(box)
        local st = box:FindFirstChildOfClass("UIStroke")
        box.Focused:Connect(function()
            Tween(st, 0.15, { Color = Theme.Accent, Transparency = 0.1 })
        end)
        box.FocusLost:Connect(function()
            Tween(st, 0.15, { Color = Theme.Stroke, Transparency = 0.3 })
        end)
    end

    function tab:AddInput(text, placeholder, callback, default)
        local row = Row(ROW_H)
        RowLabel(row, text, 0.4)
        local Box = New("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.new(0.58, -8, 0, 24),
            BackgroundColor3 = Theme.Bg,
            Text = default or "",
            PlaceholderText = placeholder or "",
            PlaceholderColor3 = Theme.SubText,
            TextColor3 = Theme.Text,
            FontFace = Fnt(Enum.FontWeight.Medium),
            TextSize = 12,
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 7,
            Parent = row,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 7) }),
            New("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.3 }),
            New("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
        })
        BoxStyle(Box)
        Box.FocusLost:Connect(function(enter)
            if callback then task.spawn(pcall, callback, Box.Text, enter) end
        end)
        local obj = {}
        function obj:Get() return Box.Text end
        function obj:Set(t) Box.Text = tostring(t or "") end
        return obj
    end

    function tab:AddTextArea(text, placeholder, height, callback)
        local row = Row(height or 120)
        local lbl = RowLabel(row, text)
        lbl.Size = UDim2.new(1, -24, 0, 26)
        local Box = New("TextBox", {
            Position = UDim2.new(0, 10, 0, 28),
            Size = UDim2.new(1, -20, 1, -38),
            BackgroundColor3 = Theme.Bg,
            Text = "",
            PlaceholderText = placeholder or "",
            PlaceholderColor3 = Theme.SubText,
            TextColor3 = Theme.Text,
            FontFace = Font.fromEnum(Enum.Font.Code),
            TextSize = 12,
            MultiLine = true,
            TextWrapped = true,
            ClearTextOnFocus = false,
            ClipsDescendants = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 7,
            Parent = row,
        }, {
            New("UICorner", { CornerRadius = UDim.new(0, 7) }),
            New("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.3 }),
            New("UIPadding", {
                PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
                PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
            }),
        })
        BoxStyle(Box)
        Box.FocusLost:Connect(function()
            if callback then task.spawn(pcall, callback, Box.Text) end
        end)
        local obj = {}
        function obj:Get() return Box.Text end
        function obj:Set(t) Box.Text = tostring(t or "") end
        return obj
    end

    function tab:AddImage(id, height)
        local row = Row(height or 140)
        local img = New("ImageLabel", {
            Position = UDim2.new(0, 8, 0, 8),
            Size = UDim2.new(1, -16, 1, -16),
            BackgroundTransparency = 1,
            Image = ToAssetId(id),
            ScaleType = Enum.ScaleType.Fit,
            ZIndex = 6,
            Parent = row,
        })
        local obj = {}
        function obj:Set(newId) img.Image = ToAssetId(newId) end
        return obj
    end

    return tab
end

