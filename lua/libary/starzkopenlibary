        LayoutOrder = 3,
        Parent = Frame,
    }, {
        New("UICorner", { CornerRadius = radius }),
        New("UIPadding", {
            PaddingLeft = UDim.new(0, o.IconOnly and 10 or 14),
            PaddingRight = UDim.new(0, o.IconOnly and 10 or 18),
        }),
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
        }),
    })

    local mainIcon = Icon(o.Icon or "star", o.IconSize or ICON_BTN, Theme.Accent)
    mainIcon.LayoutOrder = 1
    mainIcon.Parent = Button

    local Label
    if not o.IconOnly then
        Label = New("TextLabel", {
            Size = UDim2.new(0, 0, 1, 0),
